# Copy this file to .env and fill in your values

# Neon Postgres — create a project at https://console.neon.tech (or via the Neon MCP/CLI)
# and copy the pooled connection string from the dashboard.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@ep-example-pooler.region.aws.neon.tech/neondb?ssl=require

# Upstash Redis (job store; optional — falls back to in-memory if unset)
# Get these from https://console.upstash.com or `upstash redis get --db-id <id>`
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Deployment Configuration (set in Railway/Vercel dashboards)
# FRONTEND_URL=https://your-app.vercel.app  # CORS origin (Railway only)
# PORT=8000                                  # Auto-injected by Railway
# VITE_API_URL=https://your-app.up.railway.app  # Backend URL (Vercel only)
